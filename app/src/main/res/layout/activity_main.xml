<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GnssSpoof"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:alpha="0.6"
            android:text="伪造 GNSS 卫星表 · 改完立即生效，无需重启"
            android:textSize="13sp" />

        <!-- 运行状态 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="运行状态"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#14808080"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:text="读取中…"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="刷新"
            android:textSize="12sp" />

        <!-- 总开关 -->
        <Switch
            android:id="@+id/swEnable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="启用伪造"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:alpha="0.6"
            android:text="关闭时透传真实卫星数据，可用于对照"
            android:textSize="12sp" />

        <!-- 数量模式 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="数量模式"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbWave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="动态波动"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/rbFixed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="固定数量"
                android:textSize="15sp" />
        </RadioGroup>

        <!-- 固定数量 -->
        <LinearLayout
            android:id="@+id/boxFixed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFixed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="固定颗数：67"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/sbFixed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="120"
                android:min="1" />
        </LinearLayout>

        <!-- 波动区间 -->
        <LinearLayout
            android:id="@+id/boxWave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="下限：58 颗"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/sbMin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="120"
                android:min="1" />

            <TextView
                android:id="@+id/tvMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="上限：82 颗"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/sbMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="120"
                android:min="1" />
        </LinearLayout>

        <!-- 不合理参数提示 -->
        <TextView
            android:id="@+id/tvWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1AFF9800"
            android:lineSpacingExtra="2dp"
            android:padding="10dp"
            android:textColor="#E65100"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 参与定位 -->
        <TextView
            android:id="@+id/tvFix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="参与定位：22 颗"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/sbFix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80"
            android:min="0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:text="只有这一批会标记「参与定位」，其余仅「看得见」。真实设备通常 15–25 颗。"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="保存并应用"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="恢复默认"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSim"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="虚拟检测"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnReal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="真实检测"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.55"
            android:text="虚拟检测：看生成器当前会产出什么，无需系统参与。\n真实检测：临时关闭伪造 2 秒，采样接收机真实数据。"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.55"
            android:lineSpacingExtra="3dp"
            android:text="参考值：开阔地多星座合计常见 60–80 颗，室内通常 30 余颗。若主要在室内使用，把区间调到 45–70 更不显眼。"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
