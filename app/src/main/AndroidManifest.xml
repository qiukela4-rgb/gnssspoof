<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 真实检测页需要读系统 GNSS 状态 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="GnssSpoof"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true">
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="伪造 GNSS 卫星数，作用域勾选系统框架（不 Hook 目标 App）" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <!-- 声明后 LSPosed 会把 gnssspoof.xml 复制到所有进程可读的代理位置，
             否则 system_server 里的 XSharedPreferences 读不到内容（SELinux 拦截） -->
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />

        <!-- 配置界面：点开模块图标即可调参数，不必再借助 adb -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="GnssSpoof 设置">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 虚拟检测：显示生成器当前会产出的卫星表 -->
        <activity
            android:name=".SimActivity"
            android:exported="false"
            android:label="虚拟卫星检测" />

        <!-- 真实检测：临时关闭伪造，采样真实接收机的数据 -->
        <activity
            android:name=".RealActivity"
            android:exported="false"
            android:label="真实卫星检测" />
    </application>

</manifest>